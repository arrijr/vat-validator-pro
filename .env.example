# Upstash Redis (Cache + Rate Limiting)
# Create at https://console.upstash.com — free tier is enough
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# RapidAPI Proxy Secret
# Set this to the value from RapidAPI Studio → Security → "Proxy Secret"
# Requests without this header will be rejected with 403
# Leave empty during local dev (no secret check when unset)
RAPIDAPI_PROXY_SECRET=
